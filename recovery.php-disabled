<?php
declare(strict_types=1);
const DATA_DIR=__DIR__.'/data';const CONFIG_FILE=DATA_DIR.'/config.php';
if(!file_exists(CONFIG_FILE))die('DBTool이 아직 설치되지 않았습니다.');
$cfg=include CONFIG_FILE;if(!is_array($cfg))die('설정 파일 오류.');
function h($v){return htmlspecialchars((string)$v,ENT_QUOTES,'UTF-8');}
function savecfg($c){file_put_contents(CONFIG_FILE,"<?php\nreturn ".var_export($c,true).";\n",LOCK_EX);}
$err='';$ok='';
if($_SERVER['REQUEST_METHOD']==='POST'){
 $now=time();$until=(int)($cfg['recovery_lock_until']??0);$code=trim($_POST['recovery_code']??'');$pw=$_POST['password']??'';$pw2=$_POST['password2']??'';
 if($until>$now)$err='복구 기능이 잠겨 있습니다. '.ceil(($until-$now)/60).'분 후 다시 시도하세요.';
 elseif(!password_verify($code,$cfg['recovery_hash']??'')){ $f=(int)($cfg['recovery_fails']??0)+1;if($f>=5){$cfg['recovery_fails']=0;$cfg['recovery_lock_until']=$now+900;$err='5회 실패하여 15분 잠금되었습니다.';}else{$cfg['recovery_fails']=$f;$err='Recovery Code가 올바르지 않습니다.';}savecfg($cfg);}
 elseif(strlen($pw)<8)$err='새 비밀번호는 8자 이상이어야 합니다.';
 elseif($pw!==$pw2)$err='비밀번호가 일치하지 않습니다.';
 else{foreach($cfg['users'] as &$u){if(!empty($u['is_admin'])){$u['password_hash']=password_hash($pw,PASSWORD_DEFAULT);$u['force_change']=0;}}unset($u);$cfg['recovery_fails']=0;$cfg['recovery_lock_until']=0;savecfg($cfg);$ok='관리자 비밀번호가 재설정되었습니다. 이 파일을 다시 recovery.php-disabled 로 이름 변경하세요.';}
}
?><!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>DBTool Recovery</title><style>body{font-family:Arial,"Noto Sans KR",sans-serif;background:#f3f4f6;display:grid;place-items:center;min-height:100vh}.box{background:#fff;padding:28px;border-radius:16px;width:min(430px,calc(100% - 30px));box-shadow:0 12px 40px #0002}label{display:block;font-weight:bold;margin:12px 0 5px}input{width:100%;padding:11px;box-sizing:border-box;border:1px solid #ddd;border-radius:8px}button{margin-top:16px;width:100%;padding:11px;border:0;border-radius:8px;background:#111827;color:#fff;font-weight:bold}.err{background:#fee2e2;color:#991b1b;padding:10px;border-radius:8px}.ok{background:#dcfce7;color:#166534;padding:10px;border-radius:8px}.warn{background:#fff7ed;color:#9a3412;padding:10px;border-radius:8px}</style></head><body><div class="box"><h2>🔐 DBTool Recovery</h2><div class="warn">평상시에는 이 파일을 <b>recovery.php-disabled</b>로 보관하세요.</div><?php if($err):?><p class="err"><?=h($err)?></p><?php endif;?><?php if($ok):?><p class="ok"><?=h($ok)?></p><?php endif;?><form method="post"><label>Recovery Code</label><input name="recovery_code" required><label>새 관리자 비밀번호</label><input type="password" name="password" required><label>확인</label><input type="password" name="password2" required><button>비밀번호 재설정</button></form></div></body></html>